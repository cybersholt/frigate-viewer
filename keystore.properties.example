# Copy to keystore.properties for release signing. keystore.properties is gitignored.
# Generate keystore:
#   keytool -genkey -v -keystore release.jks -alias frigateviewer -keyalg RSA -keysize 2048 -validity 10000
storeFile=../release.jks
storePassword=CHANGE_ME
keyAlias=frigateviewer
keyPassword=CHANGE_ME
