root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# Compose convention is PascalCase for @Composable functions; ktlint's function-naming rule
# assumes camelCase and would otherwise flag ~95 correct declarations.
ktlint_function_naming_ignore_when_annotated_with = Composable

# One file legitimately declares several top-level types (sealed state + helpers), which the
# filename rule forbids. Cohesion beats one-type-per-file here.
ktlint_standard_filename = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
