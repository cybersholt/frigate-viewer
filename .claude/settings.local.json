{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew :app:compileDebugKotlin --quiet)",
      "Bash(adb devices *)",
      "PowerShell(Test-Path *)",
      "Bash(./gradlew :app:assembleDebug)",
      "mcp__codegraph__codegraph_files",
      "Bash(Get-ChildItem -Path \"C:\\\\Users\\\\Sean\\\\Projects\\\\frigate-viewer\\\\app\\\\src\\\\main\\\\java\\\\net\\\\triton\\\\frigateviewer\\\\ui\" -Recurse -File)",
      "Bash(Select-Object FullName)",
      "Bash(xargs grep -l \"Shimmer\\\\|shimmer\\\\|Skeleton\\\\|skeleton\")",
      "Bash(adb *)",
      "Bash(./gradlew :app:compileDebugKotlin)",
      "WebFetch(domain:docs.frigate.video)",
      "Bash(JAVA_HOME='C:/Program Files/Android/Android Studio/jbr' PATH='C:/Program Files/Android/Android Studio/jbr/bin:__TRACKED_VAR__' ./gradlew :app:assembleDebug)",
      "Bash(rm -rf .gradle/configuration-cache)",
      "Bash(JAVA_HOME='C:/Program Files/Android/Android Studio/jbr' PATH='C:/Program Files/Android/Android Studio/jbr/bin:__TRACKED_VAR__' ./gradlew :app:assembleDebug '-Dorg.gradle.java.home=C:/Program Files/Android/Android Studio/jbr')",
      "Bash(./gradlew --stop)",
      "Bash(./gradlew installDebug)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/block-secrets.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/format-kotlin.ps1"
          }
        ]
      }
    ]
  }
}
